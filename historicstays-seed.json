  "reviews": [
    { "id": "389272e6-e7ed-4beb-8bf8-5d0aec09f4ab", "stayId": "8df6978f-402a-45b9-bbc7-31d876e22394", "authorName": "Marta K.", "rating": 5, "comment": "The vaulted ceilings and the quiet courtyard made this feel like staying in a small museum, but comfortable. Ten minute walk to the castle.", "createdAt": "2026-05-12" },
    { "id": "8afa4c8b-b0d9-4dbd-92eb-19223aa068c7", "stayId": "8df6978f-402a-45b9-bbc7-31d876e22394", "authorName": "Daniel R.", "rating": 4, "comment": "Great location and character, though the stairs are steep and there's no elevator.", "createdAt": "2026-06-02" },
    { "id": "867dd057-0292-4118-bf72-3f4bff930d49", "stayId": "84eb2ec1-57be-46bb-85cd-0199be923c68", "authorName": "Tomas H.", "rating": 5, "comment": "The stucco details on the ceiling are incredible. Quiet neighborhood, easy tram into the center.", "createdAt": "2026-03-15" },
    { "id": "b469a855-2ede-4bd2-ba8c-b12ffba4f271", "stayId": "84eb2ec1-57be-46bb-85cd-0199be923c68", "authorName": "Ingrid S.", "rating": 4, "comment": "Lovely bright apartment, the balcony was a nice surprise. A bit of a walk to the main sights but worth it for the calm.", "createdAt": "2026-06-20" },
    { "id": "a7a01a64-0eaf-413d-995a-e339eb99be1f", "stayId": "51aeb6f2-b38a-4bf6-9012-a09e5ce02365", "authorName": "Pavel S.", "rating": 5, "comment": "The cellar bar area is a great surprise, felt like a private wine bar. Walking distance to everything in Old Town.", "createdAt": "2026-06-10" },
    { "id": "9c834278-542e-4283-ad6e-38fb7a3d4e49", "stayId": "51aeb6f2-b38a-4bf6-9012-a09e5ce02365", "authorName": "Anna B.", "rating": 4, "comment": "Loved seeing the 1782 date carved above the door every time we came home. Cozy and central.", "createdAt": "2026-05-03" },
    { "id": "58549984-17c1-4f4c-a8f9-99602ebd4183", "stayId": "8e7fd229-79e7-4aaf-8767-f2f22dda07ec", "authorName": "Julia W.", "rating": 5, "comment": "Felt like stepping into a Bavarian storybook. The tiled stove in the lounge is beautiful and the room itself was warm and quiet.", "createdAt": "2026-05-28" },
    { "id": "346d04c1-a478-4da5-b092-8b7079b5c50b", "stayId": "8e7fd229-79e7-4aaf-8767-f2f22dda07ec", "authorName": "Felix M.", "rating": 4, "comment": "Right above a real Gaststube, so evenings were lively downstairs, but it quieted down by night. Great location in the Altstadt.", "createdAt": "2026-07-01" },
    { "id": "eb03f6d5-aa16-4744-9079-9cf95fb6f48a", "stayId": "e1b17006-7b55-4033-9e76-3310c6057570", "authorName": "Karl M.", "rating": 5, "comment": "Waking up next to the tower wall was unforgettable. Small but perfectly located inside the walls.", "createdAt": "2026-05-25" },
    { "id": "e0ba176c-f191-44cc-a975-ffb8d7aa4229", "stayId": "e1b17006-7b55-4033-9e76-3310c6057570", "authorName": "Sofia P.", "rating": 5, "comment": "The four-poster bed and the stone walls made it feel properly medieval, in a good way. Very central.", "createdAt": "2026-04-20" },
    { "id": "4600b156-9c58-4d69-936e-ede355e7f1ff", "stayId": "8122b710-29b0-44a6-8c3a-0292731a1d62", "authorName": "Lotte D.", "rating": 4, "comment": "Classic canal house experience, mind the stairs if you have heavy luggage. Great location in the Jordaan.", "createdAt": "2026-04-30" },
    { "id": "0a612789-4993-48c4-84b3-165a41343e07", "stayId": "8122b710-29b0-44a6-8c3a-0292731a1d62", "authorName": "Bram J.", "rating": 5, "comment": "Fell asleep to boats passing on the canal. Small apartment but every window has a view worth taking a photo of.", "createdAt": "2026-06-05" }
  ]
